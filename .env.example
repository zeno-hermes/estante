# Modelo de configuração da Estante.
# Copiar para .env (`cp .env.example .env`) e preencher.

# Chave secreta do Django. Gerar uma nova com:
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Em desenvolvimento: true. Em produção: false.
DEBUG=true

# Hosts permitidos, separados por vírgula. Em produção inclui o domínio DuckDNS.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens de confiança para CSRF (necessário atrás de HTTPS), separadas por vírgula.
CSRF_TRUSTED_ORIGINS=

# Registo público de novas contas (false por omissão: as contas são criadas por script).
PERMITIR_REGISTO=false
